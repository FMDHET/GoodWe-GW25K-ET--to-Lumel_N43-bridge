# Zusätzliche Einstellungen nur für den ESP32-C3 (wird von ESP-IDF automatisch zu sdkconfig.defaults
# hinzugenommen). Der C3 hat ca. 230 kB Heap statt ca. 340 kB beim C6 - hier wird RAM gespart.

# TLS (MQTTS): Puffer nur während einer Verbindung belegen und nach dem Handshake verkleinern
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

# WLAN: weniger fest reservierte Empfangspuffer (je ca. 1,6 kB)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
